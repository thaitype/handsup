{
  "compilerOptions": {
    "target": "es2023",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["worker-configuration.d.ts", "src", "test"],
  "exclude": ["src/client", "test/client"]
}
