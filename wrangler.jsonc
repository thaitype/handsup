{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handsup",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  // The SPA (spec N4). /api/ always reaches the Worker; any other path that is not a file
  // gets index.html, so React Router handles /join, /auth/error and the rest.
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "handsup",
      // Placeholder for local development. A real id is only needed for a deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }]
  // No "vars" here on purpose. INSTRUCTOR_EMAILS is never committed (spec 7.3):
  // local values come from .dev.vars, deploys pass it with --var.
}
