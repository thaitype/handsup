{
  "name": "handsup",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.5.0",
  "dependencies": {
    "@better-auth/utils": "0.5.1",
    "better-auth": "1.7.28",
    "hono": "4.13.22"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.2",
    "@cloudflare/vitest-plugin": "1.9.2",
    "@playwright/test": "1.62.0",
    "@types/node": "22.20.7",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.168.0",
    "ws": "8.23.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "wrangler types --include-runtime true && tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "test:e2e:spikes": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "gen:auth-migration": "node scripts/gen-auth-migration.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  }
}
